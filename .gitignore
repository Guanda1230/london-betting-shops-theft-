# Raw source files are not redistributed from this repository.
data/raw/*
!data/raw/README.md

# Intermediate files can be regenerated by the code.
data/intermediate/*
!data/intermediate/README.md

# Keep only the two compiled public data files in version control.
data/processed/*
!data/processed/README.md
!data/processed/final_london_lsoa_dataset.csv
!data/processed/data_audit_summary.csv

# Generated figures and tables are reproducible.
outputs/figures/*
!outputs/figures/README.md
outputs/audit/*
!outputs/audit/README.md

# Common local and R-generated files.
.Rhistory
.RData
.Ruserdata
.DS_Store
Thumbs.db

# R temporary files
.Rhistory
.RData
.Rproj.user/

# Raw third-party datasets
crime/
data/raw/

# Large spatial source files
*.gpkg

# Temporary files
*.tmp
~$*
